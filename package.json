{
	"name": "agbd",
	"version": "0.6.1",
	"description": "Interactive CLI to safely inspect and delete Git branches (local and remote)",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/riya-amemiya/agbd.git"
	},
	"homepage": "https://github.com/riya-amemiya/agbd#readme",
	"bugs": {
		"url": "https://github.com/riya-amemiya/agbd/issues"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "oxlint && oxfmt --check",
		"lint": "oxlint --fix && oxfmt",
		"ci": "oxlint && oxfmt --check",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"git",
		"branch",
		"cleanup",
		"prune",
		"cli",
		"ink"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"ag-toolkit": "0.7.1",
		"ink": "8.0.0",
		"ink-select-input": "6.2.0",
		"ink-spinner": "5.0.0",
		"react": "19.3.1",
		"simple-git": "4.0.2",
		"valibot": "1.5.0"
	},
	"overrides": {
		"react": "19.3.1",
		"ink": "8.0.0",
		"ink-select-input": "6.2.0",
		"ink-spinner": "5.0.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "9.0.0",
		"@types/bun": "1.4.4",
		"@types/react": "19.3.0",
		"chalk": "6.0.1",
		"ink-testing-library": "4.0.0",
		"oxfmt": "0.78.0",
		"oxlint": "1.93.0",
		"ts-node": "10.9.2",
		"typescript": "7.0.2"
	}
}
